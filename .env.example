# Server-only Supabase transaction-pooler connection string.
# Never prefix this key with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SITE_URL=https://www.attriassociates.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Razorpay server credentials. Keep these server-only; never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Administrator credentials. Use a long random session secret in production.
ADMIN_EMAIL=replace-with-your-email
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
