# Server-only Supabase transaction-pooler connection string.
# Never prefix this key with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@POOLER_HOST:6543/postgres

# Optional admin overrides. Use a long random session secret in production.
ADMIN_EMAIL=attriassociates99@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
