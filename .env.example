# Server-only Supabase transaction-pooler connection string.
# Never prefix this key with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<database-password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SITE_URL=https://www.attriassociates.com

# Optional admin overrides. Use a long random session secret in production.
ADMIN_EMAIL=attriassociates99@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# One-time first-login password. It is consumed after successful use.
ADMIN_ONE_TIME_PASSWORD=replace-with-a-long-random-one-time-password
# Keep these long random values server-side. The setup token is only needed before
# the first password is stored; the reset token is used for recovery when signed out.
ADMIN_SETUP_TOKEN=replace-with-a-long-one-time-setup-token
ADMIN_PASSWORD_RESET_TOKEN=replace-with-a-long-password-recovery-token
